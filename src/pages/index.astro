---
import Layout from '../layouts/Layout.astro';
---
<Layout locale="en" mode="view">
  <script>
    import 'leaflet/dist/leaflet.css';
    import { DamascusTransitViewer } from '../scripts/viewer-app';

    const mapEl = document.getElementById('map')!;
    const sidebarEl = document.getElementById('line-list')!;

    new DamascusTransitViewer({ mapEl, sidebarEl, locale: 'en' });
  </script>
</Layout>
