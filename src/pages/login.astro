---
import '../styles/global.css';
import { dictionaries } from '../i18n/ui';

const dict = dictionaries.en;
const to = Astro.url.searchParams.get('to') ?? '/admin';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{dict.loginTitle}</title>
  </head>
  <body class="login-body">
    <form id="login-form" class="login-card" method="post" action={`${base}/api/admin-auth`}>
      <h1>{dict.loginTitle}</h1>
      <p class="subtitle">{dict.loginSubtitle}</p>
      <input type="hidden" name="to" value={to} />
      <label class="login-field">
        {dict.password}
        <input type="password" name="password" autocomplete="current-password" required autofocus />
      </label>
      <p id="login-error" class="login-error" hidden>{dict.loginInvalid}</p>
      <button class="btn btn-primary" type="submit">{dict.loginButton}</button>
      <a class="btn btn-link" href={`${base}/`}>{dict.viewMap}</a>
    </form>
    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorEl = document.getElementById('login-error') as HTMLParagraphElement;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.hidden = true;
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          const { to } = await res.json();
          window.location.href = to;
        } else {
          errorEl.hidden = false;
        }
      });
    </script>
  </body>
</html>
