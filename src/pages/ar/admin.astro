---
import Layout from '../../layouts/Layout.astro';
---
<Layout locale="ar" mode="admin">
  <script>
    import 'leaflet/dist/leaflet.css';
    import { DamascusTransitApp } from '../../scripts/transit-app';
    import { ADMIN_AUTH_API_URL } from '../../lib/api';

    const res = await fetch(ADMIN_AUTH_API_URL, { headers: { Accept: 'application/json' } });
    const { authenticated } = await res.json().catch(() => ({ authenticated: false }));
    if (!authenticated) {
      window.location.href = `/ar/login?to=${encodeURIComponent(window.location.pathname)}`;
    } else {
      const mapEl = document.getElementById('map')!;
      const sidebarEl = document.getElementById('line-list')!;
      const editorEl = document.getElementById('line-editor')!;
      const addLineBtn = document.getElementById('add-line-btn') as HTMLButtonElement;
      const exportBtn = document.getElementById('export-btn') as HTMLButtonElement;
      const importBtn = document.getElementById('import-btn') as HTMLButtonElement;
      const importInput = document.getElementById('import-input') as HTMLInputElement;

      new DamascusTransitApp({ mapEl, sidebarEl, editorEl, addLineBtn, exportBtn, importBtn, importInput, locale: 'ar' });
    }
  </script>
</Layout>
