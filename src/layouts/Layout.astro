---
import type { Locale } from '../lib/types';
import { dictionaries } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  mode?: 'view' | 'admin';
}

const { locale, mode = 'view' } = Astro.props as Props;
const dict = dictionaries[locale];
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'ar' ? `${base}/ar` : base;
const otherLocaleHref = locale === 'ar' ? `${base}${mode === 'admin' ? '/admin' : ''}/` : `${base}/ar${mode === 'admin' ? '/admin' : ''}/`;
const modeSwitchHref = mode === 'admin' ? `${prefix}/` : `${prefix}/admin/`;
const modeSwitchLabel = mode === 'admin' ? dict.viewMap : dict.admin;
const pageTitle = mode === 'admin' ? `${dict.title} — ${dict.admin}` : dict.title;
---
<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div id="app">
      <header class="app-header">
        <div class="header-title">
          <h1>{dict.title}</h1>
          <p class="subtitle">{dict.subtitle}</p>
        </div>
        <button id="nav-toggle" class="icon-toggle" type="button" aria-label={dict.menu} aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="header-nav" id="header-nav">
          <a class="nav-link" href={modeSwitchHref}>{modeSwitchLabel}</a>
          <a class="nav-link" href={otherLocaleHref}>{dict.langSwitch}</a>
          {mode === 'admin' && <button id="logout-btn" class="nav-link nav-btn" type="button">{dict.logout}</button>}
        </nav>
      </header>
      <div class="layout">
        <button id="sidebar-toggle" class="sidebar-toggle" type="button" aria-expanded="false">
          <span class="sidebar-toggle-icon">☰</span> {dict.linesToggle}
        </button>
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">
            <h2>{dict.lines}</h2>
            {mode === 'admin' && <button id="add-line-btn" class="btn btn-primary">{dict.addLine}</button>}
          </div>
          <ul id="line-list" class="line-list"></ul>
          {mode === 'admin' && (
            <>
              <div id="line-editor" class="editor-panel" hidden></div>
              <div class="data-actions">
                <button id="export-btn" class="btn btn-link">{dict.exportData}</button>
                <button id="import-btn" class="btn btn-link">{dict.importData}</button>
                <input id="import-input" type="file" accept="application/json,.json" hidden />
              </div>
            </>
          )}
        </aside>
        <main id="map" class="map"></main>
      </div>
    </div>
    <slot />
    <script is:inline>
      // Mobile menu toggles (no-ops on desktop where buttons are hidden).
      // is:inline keeps this unbundled so it runs immediately without waiting
      // for module resolution.
      (function () {
        var navToggle = document.getElementById('nav-toggle');
        var headerNav = document.getElementById('header-nav');
        if (navToggle && headerNav) {
          navToggle.addEventListener('click', function () {
            var open = headerNav.classList.toggle('open');
            navToggle.setAttribute('aria-expanded', String(open));
          });
        }

        var sidebarToggle = document.getElementById('sidebar-toggle');
        var sidebar = document.getElementById('sidebar');
        if (sidebarToggle && sidebar) {
          sidebarToggle.addEventListener('click', function () {
            var open = sidebar.classList.toggle('open');
            sidebarToggle.setAttribute('aria-expanded', String(open));
          });
        }
      })();
    </script>
    {mode === 'admin' && (
      <script>
        import { ADMIN_AUTH_API_URL } from '../lib/api';
        const logoutBtn = document.getElementById('logout-btn');
        logoutBtn?.addEventListener('click', async () => {
          await fetch(ADMIN_AUTH_API_URL, { method: 'DELETE' });
          window.location.href = '/';
        });
      </script>
    )}
  </body>
</html>
